<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Safe Browsing Sites for Kids – Kids Home Safe</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-950 text-slate-100">

  <!-- NAVBAR -->
  <header class="border-b border-slate-800 bg-slate-950/80 backdrop-blur sticky top-0 z-30">
    <nav class="max-w-6xl mx-auto px-4 py-3 flex items-center justify-between">
      
      <!-- Brand -->
      <a href="index.html" class="flex items-center gap-3">
        <img src="assets/logo.png" alt="Kids Home Safe Logo" class="h-10 w-10 object-contain" />
        <span class="font-semibold text-lg">Kids Home Safe</span>
      </a>

      <!-- Nav Links -->
      <div class="flex items-center gap-8 text-sm font-medium">
        <a href="filters.html" class="hover:text-indigo-300">Web Filters</a>
        <a href="kids-safe-browsing.html" class="hover:text-indigo-300 text-indigo-300 font-semibold">Safe Browsing</a>
        <a href="device-monitoring.html" class="hover:text-indigo-300">Phones &amp; Apps</a>
        <a href="services.html" class="hover:text-indigo-300">Home Setup</a>
      </div>

    </nav>
  </header>

  <main class="max-w-6xl mx-auto px-4 pt-10 pb-16">
    <h1 class="text-3xl font-semibold mb-3">Safe Browsing Sites for Kids</h1>
    <p class="text-slate-300 mb-8 max-w-2xl">
      A curated list of parent-approved, safe, and educational websites for younger kids and older kids (10+). These
      are great starting points when you want your child online, but only in places that are designed for them.
    </p>

    <!-- AGES 3–9 -->
    <section class="mb-14">
      <h2 class="text-2xl font-semibold mb-4">Safe Sites for Ages 3–9</h2>
      <p class="text-xs text-slate-400 mb-4">
        Best for preschool and elementary ages. Focused on early learning,
        reading, basic math, and gentle shows.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 text-sm">
        
        <!-- ABCmouse -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col">
          <div class="flex justify-center mb-2">
            <span class="px-2 py-0.5 rounded-full bg-indigo-500/20 text-[10px] font-semibold tracking-wide text-indigo-300 uppercase">
              Early learning
            </span>
          </div>
          <img src="assets/abcmouse.png" class="h-16 mx-auto mb-3 object-contain" alt="ABCmouse" />
          <h3 class="font-semibold mb-1 text-center">ABCmouse</h3>
          <p class="text-slate-300 mb-3 text-center">
            Full early-learning program for reading, math, science, and art. Ad-free and structured.
          </p>
          <a href="https://www.abcmouse.com" class="mt-auto text-indigo-300 text-xs underline block text-center">
            Visit ABCmouse
          </a>
        </div>

        <!-- PBS Kids -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col">
          <div class="flex justify-center mb-2">
            <span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-[10px] font-semibold tracking-wide text-emerald-300 uppercase">
              Shows &amp; games
            </span>
          </div>
          <img src="assets/pbskids.png" class="h-16 mx-auto mb-3 object-contain" alt="PBS Kids" />
          <h3 class="font-semibold mb-1 text-center">PBS Kids</h3>
          <p class="text-slate-300 mb-3 text-center">
            Games and videos from trusted PBS Kids shows like Wild Kratts and Daniel Tiger.
          </p>
          <a href="https://pbskids.org" class="mt-auto text-indigo-300 text-xs underline block text-center">
            Visit PBS Kids
          </a>
        </div>

        <!-- National Geographic Kids -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col">
          <div class="flex justify-center mb-2">
            <span class="px-2 py-0.5 rounded-full bg-sky-500/20 text-[10px] font-semibold tracking-wide text-sky-300 uppercase">
              Science &amp; nature
            </span>
          </div>
          <img src="assets/natgeokids.png" class="h-16 mx-auto mb-3 object-contain" alt="NatGeo Kids" />
          <h3 class="font-semibold mb-1 text-center">National Geographic Kids</h3>
          <p class="text-slate-300 mb-3 text-center">
            Animal facts, science videos, quizzes, and geography fun.
          </p>
          <a href="https://kids.nationalgeographic.com" class="mt-auto text-indigo-300 text-xs underline block text-center">
            Visit NatGeo Kids
          </a>
        </div>

        <!-- Starfall -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col">
          <div class="flex justify-center mb-2">
            <span class="px-2 py-0.5 rounded-full bg-pink-500/20 text-[10px] font-semibold tracking-wide text-pink-300 uppercase">
              Reading
            </span>
          </div>
          <img src="assets/starfall.png" class="h-16 mx-auto mb-3 object-contain" alt="Starfall" />
          <h3 class="font-semibold mb-1 text-center">Starfall</h3>
          <p class="text-slate-300 mb-3 text-center">
            Reading and phonics activities perfect for early learners.
          </p>
          <a href="https://www.starfall.com" class="mt-auto text-indigo-300 text-xs underline block text-center">
            Visit Starfall
          </a>
        </div>

        <!-- FunBrain -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col">
          <div class="flex justify-center mb-2">
            <span class="px-2 py-0.5 rounded-full bg-amber-500/20 text-[10px] font-semibold tracking-wide text-amber-300 uppercase">
              Math &amp; reading
            </span>
          </div>
          <img src="assets/funbrain.png" class="h-16 mx-auto mb-3 object-contain" alt="FunBrain" />
          <h3 class="font-semibold mb-1 text-center">FunBrain</h3>
          <p class="text-slate-300 mb-3 text-center">
            Math, reading, and logic games trusted by schools.
          </p>
          <a href="https://www.funbrain.com" class="mt-auto text-indigo-300 text-xs underline block text-center">
            Visit FunBrain
          </a>
        </div>

        <!-- Sesame Street -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col">
          <div class="flex justify-center mb-2">
            <span class="px-2 py-0.5 rounded-full bg-rose-500/20 text-[10px] font-semibold tracking-wide text-rose-300 uppercase">
              Early learning
            </span>
          </div>
          <img src="assets/sesame.png" class="h-16 mx-auto mb-3 object-contain" alt="Sesame Street" />
          <h3 class="font-semibold mb-1 text-center">Sesame Street</h3>
          <p class="text-slate-300 mb-3 text-center">
            Videos and games with gentle learning and social-emotional themes.
          </p>
          <a href="https://www.sesamestreet.org" class="mt-auto text-indigo-300 text-xs underline block text-center">
            Visit Sesame Street
          </a>
        </div>

      </div>
    </section>

    <!-- AGES 10+ -->
    <section>
      <h2 class="text-2xl font-semibold mb-4">Safe Sites for Ages 10+</h2>
      <p class="text-xs text-slate-400 mb-4">
        Great for older elementary, middle school, and early teens. Focused on school support, coding, science, and creativity.
      </p>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 text-sm">

        <!-- Khan Academy -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col">
          <div class="flex justify-center mb-2">
            <span class="px-2 py-0.5 rounded-full bg-indigo-500/20 text-[10px] font-semibold tracking-wide text-indigo-300 uppercase">
              School help
            </span>
          </div>
          <img src="assets/khan.png" class="h-16 mx-auto mb-3 object-contain" alt="Khan Academy" />
          <h3 class="font-semibold mb-1 text-center">Khan Academy</h3>
          <p class="text-slate-300 mb-3 text-center">
            Free learning in math, science, history and more. Great for homework support.
          </p>
          <a href="https://www.khanacademy.org" class="mt-auto text-indigo-300 text-xs underline block text-center">
            Visit Khan Academy
          </a>
        </div>

        <!-- Codecademy -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col">
          <div class="flex justify-center mb-2">
            <span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-[10px] font-semibold tracking-wide text-emerald-300 uppercase">
              Coding
            </span>
          </div>
          <img src="assets/codecademy.png" class="h-16 mx-auto mb-3 object-contain" alt="Codecademy" />
          <h3 class="font-semibold mb-1 text-center">Codecademy</h3>
          <p class="text-slate-300 mb-3 text-center">
            Beginner-friendly coding lessons. Best with a parent nearby to help choose courses.
          </p>
          <a href="https://www.codecademy.com" class="mt-auto text-indigo-300 text-xs underline block text-center">
            Visit Codecademy
          </a>
        </div>

        <!-- NASA Kids -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col">
          <div class="flex justify-center mb-2">
            <span class="px-2 py-0.5 rounded-full bg-sky-500/20 text-[10px] font-semibold tracking-wide text-sky-300 uppercase">
              Space &amp; science
            </span>
          </div>
          <img src="assets/nasa.png" class="h-16 mx-auto mb-3 object-contain" alt="NASA Kids Club" />
          <h3 class="font-semibold mb-1 text-center">NASA Kids Club</h3>
          <p class="text-slate-300 mb-3 text-center">
            Games, missions, and activities from NASA for space-loving kids.
          </p>
          <a href="https://www.nasa.gov/kidsclub/index.html" class="mt-auto text-indigo-300 text-xs underline block text-center">
            Visit NASA Kids Club
          </a>
        </div>

        <!-- FunBrain (10+) -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col">
          <div class="flex justify-center mb-2">
            <span class="px-2 py-0.5 rounded-full bg-amber-500/20 text-[10px] font-semibold tracking-wide text-amber-300 uppercase">
              Math &amp; logic
            </span>
          </div>
          <img src="assets/funbrain.png" class="h-16 mx-auto mb-3 object-contain" alt="FunBrain" />
          <h3 class="font-semibold mb-1 text-center">FunBrain (10+)</h3>
          <p class="text-slate-300 mb-3 text-center">
            Logic puzzles, math games, and interactive books for older kids.
          </p>
          <a href="https://www.funbrain.com" class="mt-auto text-indigo-300 text-xs underline block text-center">
            Visit FunBrain
          </a>
        </div>

        <!-- SwitchZoo -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col">
          <div class="flex justify-center mb-2">
            <span class="px-2 py-0.5 rounded-full bg-lime-500/20 text-[10px] font-semibold tracking-wide text-lime-300 uppercase">
              Science &amp; creativity
            </span>
          </div>
          <img src="assets/switchzoo.png" class="h-16 mx-auto mb-3 object-contain" alt="SwitchZoo" />
          <h3 class="font-semibold mb-1 text-center">SwitchZoo</h3>
          <p class="text-slate-300 mb-3 text-center">
            Create animals, explore habitats, and learn biology in a playful way.
          </p>
          <a href="https://www.switchzoo.com" class="mt-auto text-indigo-300 text-xs underline block text-center">
            Visit SwitchZoo
          </a>
        </div>

        <!-- Highlights Kids -->
        <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-5 flex flex-col">
          <div class="flex justify-center mb-2">
            <span class="px-2 py-0.5 rounded-full bg-rose-500/20 text-[10px] font-semibold tracking-wide text-rose-300 uppercase">
              Reading &amp; creativity
            </span>
          </div>
          <img src="assets/highlights.png" class="h-16 mx-auto mb-3 object-contain" alt="Highlights Kids" />
          <h3 class="font-semibold mb-1 text-center">Highlights Kids</h3>
          <p class="text-slate-300 mb-3 text-center">
            Jokes, stories, crafts, and games from the classic Highlights magazine.
          </p>
          <a href="https://www.highlightskids.com" class="mt-auto text-indigo-300 text-xs underline block text-center">
            Visit Highlights Kids
          </a>
        </div>

      </div>
    </section>
  </main>

  <!-- FOOTER -->
  <footer class="border-t border-slate-800 py-6 text-xs text-slate-500">
    <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
      <p>© <span id="year"></span> Kids Home Safe. All rights reserved.</p>
      <div class="flex gap-4">
        <a href="services.html#contact" class="hover:text-indigo-300">Contact</a>
        <a href="#" class="hover:text-indigo-300">Privacy</a>
      </div>
    </div>
    <script>
      document.getElementById('year').textContent = new Date().getFullYear();
    </script>
  </footer>

</body>
</html>
